{
  "name": "snes-graph",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src scripts tests docs README.md",
    "bundle:linux": "NO_STRIP=1 tauri build --bundles rpm,appimage -- --locked",
    "bundle:windows": "tauri build --bundles nsis -- --locked",
    "dev": "vite --host 127.0.0.1",
    "build": "npm run version:check && tsc --noEmit && vite build",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "export": "tsx scripts/export.ts",
    "example": "tsx scripts/example.ts",
    "examples:integration": "tsx scripts/integration-examples.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "version:set": "node --import tsx scripts/version.ts",
    "version:check": "node --import tsx scripts/version.ts --check",
    "release:notes": "node --import tsx scripts/release-notes.ts",
    "bundle:ubuntu": "NO_STRIP=1 tauri build --bundles deb,appimage -- --locked",
    "bundle:fedora": "tauri build --bundles rpm -- --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "fast-png": "^8.0.0",
    "fflate": "^0.8.3",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "license": "MIT"
}
